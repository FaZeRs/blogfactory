# Copy to .env before running Docker Compose. Generate every required secret.
BLOGFACTORY_VERSION=v0.1.0
BLOGFACTORY_PORT=8080
BLOGFACTORY_URL=http://localhost:8080
ADMIN_EMAILS=
BLOGFACTORY_ALLOW_SIGNUP=true

POSTGRES_PASSWORD=
MINIO_ROOT_USER=blogfactory
MINIO_ROOT_PASSWORD=
MINIO_CONSOLE_PORT=9001

# Generate each secret independently with: openssl rand -hex 32
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
CRON_SECRET=
OPENROUTER_WEBHOOK_SECRET=

# Used only while building the bundled marketing fallback.

# Optional staged blog engine adapters (normal/deep modes need a persistent worker).
# SEARXNG_URL=
# CRAWL4AI_URL=
# CRAWL4AI_TOKEN=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_MONTHLY_USD=10
# ENGINE_AI_BASE_URL=
# ENGINE_AI_API_KEY=

# Optional Google Search Console OAuth.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=
